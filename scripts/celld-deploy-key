#!/usr/bin/python3
"""Root-only labeled owner/CI public-key installation and revocation."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile

CONFIG = Path('/etc/celld-ctl')
AUTHORIZED = Path('/etc/ssh/cella-deploy/authorized_keys')

def atomic(path, data):
    fd, name = tempfile.mkstemp(prefix='.keys-', dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, 'w') as output:
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='op', required=True)
    add = commands.add_parser('add')
    add.add_argument('label')
    add.add_argument('public_key', type=Path)
    add.add_argument('--kind', choices=['owner', 'ci'], required=True)
    revoke = commands.add_parser('revoke')
    revoke.add_argument('label')
    commands.add_parser('list')
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error('Run as root')
    if args.op != 'list' and not re.fullmatch(r'[a-zA-Z0-9_-]{1,64}', args.label):
        parser.error('Label must be 1–64 letters, digits, hyphens or underscores')
    with open(CONFIG / 'deploy-keys.lock', 'a') as lock:
        os.chmod(lock.name, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        inventory = CONFIG / 'deploy-keys.json'
        keys = json.loads(inventory.read_text()) if inventory.exists() else {}
        if args.op == 'list':
            print(json.dumps(keys, indent=2))
            return
        if not inventory.exists() and AUTHORIZED.read_text().strip():
            parser.error('Refusing to replace untracked authorized keys')
        if args.op == 'add':
            if args.label in keys:
                parser.error('Label already exists; revoke first')
            text = args.public_key.read_text()
            if len(text) > 16384 or len(text.strip().splitlines()) != 1:
                parser.error('Expected one OpenSSH public key')
            fields = text.split()
            if len(fields) < 2 or fields[0] not in ('ssh-ed25519', 'ssh-rsa', 'ecdsa-sha2-nistp256', 'ecdsa-sha2-nistp384', 'ecdsa-sha2-nistp521'):
                parser.error('Unsupported public key')
            key = ' '.join(fields[:2])
            # ssh-keygen verifies the public key bytes, not merely their base64 syntax.
            with tempfile.NamedTemporaryFile(mode='w') as tmp:
                tmp.write(key + '\n')
                tmp.flush()
                result = subprocess.run(['/usr/bin/ssh-keygen', '-lf', tmp.name], capture_output=True, text=True)
            if result.returncode:
                parser.error('Invalid public key')
            fingerprint = result.stdout.split()[1]
            if any(item['fingerprint'] == fingerprint for item in keys.values()):
                parser.error('Key is already installed under another label')
            keys[args.label] = dict(kind=args.kind, key=key, fingerprint=fingerprint)
        else:
            if args.label not in keys:
                parser.error('Unknown label')
            del keys[args.label]
        rendered = ''.join(f'restrict {item["key"]} cella:{item["kind"]}:{label}\n' for label, item in sorted(keys.items()))
        # Write effective authorization first: revocation takes effect even if inventory write fails.
        atomic(AUTHORIZED, rendered)
        atomic(inventory, json.dumps(keys, indent=2) + '\n')
        print(f'{args.op}: {args.label}')

if __name__ == '__main__':
    main()
