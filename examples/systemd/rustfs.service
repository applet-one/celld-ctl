[Unit]
Description=Private single-node RustFS object storage for celld
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=rustfs
Group=rustfs
EnvironmentFile=/etc/rustfs/rustfs.env
Environment=RUSTFS_REGION=us-east-1 RUSTFS_DURABILITY_MODE=strict RUSTFS_NEW_BUCKET_DURABILITY_MODE=strict RUSTFS_CONSOLE_ENABLE=false
StateDirectory=rustfs
StateDirectoryMode=0700
ExecStart=/usr/local/lib/rustfs/releases/v1.0.1/rustfs server --address 127.0.0.1:9000 /var/lib/rustfs
Restart=on-failure
RestartSec=3
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rustfs
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
