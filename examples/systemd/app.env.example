# Root-owned in a real installation. Never commit live values.
CELLD_BUCKET=s3://BUCKET/cells/APP_SLUG
S3_ENDPOINT=https://OBJECT_STORE_ENDPOINT
AWS_REGION=auto
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
CELLD_ADDR=127.0.0.1:APP_PORT
CELLD_INTERNAL_ADDR=127.0.0.1:INTERNAL_PORT
CELLD_WATCH=/var/lib/celld/APP_SLUG
CELLD_TRUST_FORWARDED_HEADERS=1
