[Unit]
Description=celld application %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=celld
Group=celld
EnvironmentFile=/etc/celld/cells/%i.env
StateDirectory=celld/%i
StateDirectoryMode=0700
WorkingDirectory=/var/lib/celld/%i
ExecStart=/usr/local/libexec/celld-run --listen ${CELLD_ADDR} --internal-listen ${CELLD_INTERNAL_ADDR} --advertise ${CELLD_INTERNAL_ADDR} --trust-forwarded-headers
Restart=on-failure
RestartSec=3
TimeoutStopSec=90
MemoryMax=256M
CPUQuota=50%
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/celld/%i
UMask=0077
LogNamespace=celld

[Install]
WantedBy=multi-user.target
