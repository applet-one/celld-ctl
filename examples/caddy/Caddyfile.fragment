# Illustration only; celld-ctl renders the installed file from its registry.
# HTTP is terminated by a trusted HTTPS proxy outside this host.
{
    admin 127.0.0.1:2019
    auto_https off
}
:8000 {
    @bare path /APP_SLUG
    redir @bare /APP_SLUG/ 308
    handle /APP_SLUG/* {
        reverse_proxy 127.0.0.1:APP_PORT {
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Forwarded-Host {http.request.header.X-Forwarded-Host}
        }
    }
    handle / {
        root * /var/lib/celld-ctl/public
        rewrite * /index.html
        file_server
    }
    handle {
        respond "Not found" 404
    }
}
